GOONG_API_KEY=
# Map Key của Goong (khác API Key): khóa CÔNG KHAI để trình duyệt tải bản đồ khi bấm "Chỉ đường". Tạo ở https://account.goong.io/keys
# và giới hạn theo tên miền. Bỏ trống thì bản đồ dùng nền OpenStreetMap (vẫn vẽ được tuyến). Không đặt GOONG_API_KEY vào đây.
GOONG_MAPTILES_KEY=
METEOSOURCE_API_KEY=

# Restaurant Search Service (cổng 4003). Bỏ trống MYSQL_* để dùng kho in-memory với dữ liệu mẫu.
RESTAURANT_SEARCH_PORT=4003
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=mua_gi_day_catalog
# Mặc định gọi Routing & Geo Service chạy trong server preview (cùng cổng PORT). Đổi sang http://localhost:4004 khi chạy riêng.
GEO_SERVICE_URL=
# Tùy chọn: lấy điểm đánh giá từ feedback-review-service (http://localhost:4005) để sắp xếp theo rating.
REVIEW_SERVICE_URL=
# API nội bộ của Catalog (/api/internal/v1/*) cho feedback-review-service và trang Admin. Bỏ trống thì API này tắt (503).
# Đặt chuỗi ngẫu nhiên dài (ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# Bên gọi gửi header X-Internal-Token. API Gateway không được chuyển tiếp tiền tố /api/internal/ ra ngoài.
INTERNAL_API_TOKEN=

# Routing & Geo Service (cổng 4004). Dùng GOONG_API_KEY ở đầu tệp. Bỏ trống GEO_MYSQL_DATABASE để dùng kho in-memory (3 khu vực mẫu).
GEO_SERVICE_PORT=4004
# Đặt GEO_MYSQL_DATABASE=mua_gi_day_geo (sau khi chạy db/schema.sql) để lưu SEARCH_AREA vào MySQL.
# GEO_MYSQL_HOST/PORT/USER/PASSWORD bỏ trống thì dùng MYSQL_* ở trên.
GEO_MYSQL_DATABASE=
GEO_MYSQL_HOST=
GEO_MYSQL_PORT=
GEO_MYSQL_USER=
GEO_MYSQL_PASSWORD=
# API nội bộ quản lý khu vực (/api/internal/v1/geo/*). Bỏ trống thì dùng INTERNAL_API_TOKEN; cả hai trống thì API này tắt (503).
GEO_INTERNAL_API_TOKEN=
